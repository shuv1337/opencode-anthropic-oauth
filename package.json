{
  "name": "opencode-anthropic-oauth",
  "version": "0.7.1",
  "description": "OpenCode plugin for Anthropic Claude Pro/Max OAuth login \u2014 no Claude Code needed.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-next-15329",
    "@ai-sdk/anthropic": "3.0.82",
    "effect": "4.0.0-beta.83"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "opencode",
    "anthropic",
    "claude",
    "oauth",
    "plugin",
    "auth"
  ],
  "license": "MIT"
}
